{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // Widen rootDir to the SDK root: this game imports from ../../src, which
    // sits outside the parent tsconfig's rootDir (./src) and would otherwise
    // trip TS6059. Under noEmit it only affects that source-tree check.
    "rootDir": "..",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*"]
}
